# Copy to .env. Both are optional for local development.

# The API. Unset, the app uses the machine Metro is served from on port 3000,
# which is right for `npm run dev` at the repo root.
# EXPO_PUBLIC_API_URL=https://juno-web-production-bd2e.up.railway.app

# Where shared links open. Unset, links use the API host, which redirects.
# EXPO_PUBLIC_APP_URL=https://juno-app-chi.vercel.app
