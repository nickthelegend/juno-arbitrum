# Copy to .env. All are optional for local development.

# The API. Unset, the app uses the machine Metro is served from on port 3000,
# which is right for the server's `npm run dev`.
# EXPO_PUBLIC_API_URL=https://<juno-arb-api>.up.railway.app

# The chain: 421614 (Arbitrum Sepolia, the default) or 42161 (Arbitrum One).
# EXPO_PUBLIC_CHAIN_ID=421614

# An RPC for receipts and revert reasons. Unset, the chain's public RPC.
# EXPO_PUBLIC_RPC_URL=

# Privy's public app and client ids. Unset, Juno's own. Never put the app secret here.
# EXPO_PUBLIC_PRIVY_APP_ID=
# EXPO_PUBLIC_PRIVY_CLIENT_ID=
# The web build uses the app's default Privy client unless this is set.
# EXPO_PUBLIC_PRIVY_WEB_CLIENT_ID=

# Where shared links open. Unset, links use the API host.
# EXPO_PUBLIC_APP_URL=
