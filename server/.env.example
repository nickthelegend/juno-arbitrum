# Juno Arbitrum server. Copy to .env.local and fill in. Names only here.

# Postgres (new database `juno_arb`)
DATABASE_URL=
# Optional: direct URL for migrations when DATABASE_URL is a pooler
DATABASE_URL_UNPOOLED=
# Optional: "disable" | "require"
DATABASE_SSL=
DATABASE_POOL_MAX=

# Mongo (comments, likes, profiles, faucet rate limits)
MONGODB_URI=
MONGODB_DB=juno_arb

# Chains
APP_CHAIN_ID=421614
ARB_SEPOLIA_RPC=
ARB_ONE_RPC=
# Optional: first block to index per chain (defaults to the factory's deploy block)
JUNO_FACTORY_BLOCK_421614=
JUNO_FACTORY_BLOCK_42161=
# Optional: initial market cap for post launches, in ETH (defaults 0.02 Sepolia, 1.0 One)
JUNO_INITIAL_MCAP_ETH=
JUNO_INITIAL_MCAP_ETH_421614=
JUNO_INITIAL_MCAP_ETH_42161=
# Optional: when set, POST /api/juno/index needs header x-juno-index-secret
JUNO_INDEX_SECRET=
# Optional: poll the indexer in-process every N ms (e.g. 30000) on a long-running server
JUNO_INDEX_INTERVAL_MS=
# Optional: "0" stops the server graduating a curve (from the faucet key) after the buy that fills it
JUNO_AUTO_GRADUATE=

# Local anvil fork only (see scripts/fork-env.sh): merge ../config/addresses.local.json
JUNO_LOCAL_ADDRESSES=
# Integration tests on real Sepolia: a funded test key (never a real wallet)
JUNO_TEST_PRIVATE_KEY=

# Media
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=

# Faucet (Arbitrum Sepolia only)
FAUCET_PRIVATE_KEY=
FAUCET_ADDRESS=

# Kept from the Solana deploy for parity; unused by the Arbitrum server today
CUSTODIAL_KEY_ENCRYPTION_SECRET=
