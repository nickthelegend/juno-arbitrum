{
  "name": "juno-arbitrum-server",
  "version": "0.1.0",
  "private": true,
  "description": "Juno API on Arbitrum: indexer, hydration, transaction builders, social.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:create": "tsx --env-file=.env.local scripts/create-db.ts",
    "mongo:indexes": "tsx --env-file=.env.local scripts/mongo-indexes.ts",
    "index": "tsx --env-file=.env.local --conditions=react-server scripts/run-indexer.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "drizzle-orm": "^0.45.2",
    "mongodb": "^7.6.0",
    "next": "^16.2.9",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@ffmpeg-installer/darwin-arm64@4.1.5": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
